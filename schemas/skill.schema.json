{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/skill.schema.json",
  "title": "Engineering Skill Metadata",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
