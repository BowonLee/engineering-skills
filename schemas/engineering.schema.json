{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/engineering.schema.json",
  "title": "Engineering Manifest",
  "type": "object",
  "required": ["version", "registry", "skills"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "registry": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["local", "git"]
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
